@page "/"
@page "/index.html"
@using LaserBatcher.Services
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
<PageTitle>LaserBatcher | SVG Batching for Laser Cutting</PageTitle>
<div class="workspace-shell">
    <div class="workspace-toolbar" role="group" aria-label="Job toolbar">
        <label class="btn btn-sm btn-outline-secondary open-svg" for="svgUpload">Open SVG<InputFile id="svgUpload" OnChange="HandleFileUpload" accept=".svg" aria-label="Open SVG" /></label>
        <span class="source-filename" title="@sourceFilename">@(sourceFilename.Length == 0 ? "No file selected" : sourceFilename)</span>
        <label class="visually-hidden" for="workMode">Workflow</label><select id="workMode" class="form-select form-select-sm workflow-select" value="@workMode" @onchange="ModeChanged"><option value="CreateBatch">Create batch</option><option value="EditMetadata" disabled="@(analysis?.Metadata == null)">Edit metadata</option></select>
        @if (!EditingMetadata) {
            <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleMapping">Mapping</button>
            <button class="btn btn-sm btn-outline-secondary compact-only" @onclick="OpenSheet">Sheet</button>
        }
        <button class="btn btn-sm btn-outline-secondary compact-only" @onclick="OpenProgram">Program</button>
        <div class="run-controls button-group">
            @if (!EditingMetadata) {
                <span title="@(BlockingReason ?? "Generate a batch preview; this does not start a laser.")"><button class="btn btn-sm btn-primary" aria-label="Render batch" aria-describedby="workspace-status" disabled="@(BlockingReason != null)" @onclick="RenderGrid"><span aria-hidden="true">▶</span> Render</button></span>
                <button class="btn btn-sm btn-outline-secondary clear-preview" disabled="@(rendering == null)" @onclick="Invalidate">Clear preview</button>
            }
            <span title="@(EditingMetadata ? BlockingReason : rendering == null ? "Render the current batch before downloading." : "Download the rendered SVG")"><button class="btn btn-sm btn-primary" disabled="@(EditingMetadata ? MetadataBlocked : rendering == null)" @onclick="SaveBatch">@(EditingMetadata ? "Download updated SVG" : "Download SVG")</button></span>
        </div>
        <div class="review-controls button-group">
            <button class="btn btn-sm btn-outline-secondary" @onclick="OpenRuntime">Runtime@(Runtime != null ? " •" : "")</button>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(analysis == null)" @onclick="() => hiddenDialog.OpenAsync()">Hidden content</button>
            @if (analysis?.Glowforge.Steps.Count > 0) { <button class="btn btn-sm btn-outline-secondary" @onclick="() => glowforgeDialog.OpenAsync()">Glowforge</button> }
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => issuesDialog.OpenAsync()">Issues (@IssueCount)</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => helpDialog.OpenAsync()">Help</button>
        </div>
    </div>
    <div class="desktop-settings">
        @if (!EditingMetadata) { <SheetFields Value="sheet" Changed="BatchChanged" Fill="CalculateFillSheet" CanFill="@(analysis != null)" /> }
        <ProgramFields Value="program" Changed="MetadataChanged" EditingMetadata="EditingMetadata" />
        @if (!EditingMetadata) { <div class="ordering-field"><label for="ordering">Operation order</label><select id="ordering" class="form-select form-select-sm" @bind="ordering" @bind:after="BatchChanged"><option value="@OrderingMode.WithinEachCopy">Within each copy</option><option value="@OrderingMode.AcrossSheet">Across the sheet</option></select></div> }
    </div>
    <div class="work-area @((panelCollapsed || EditingMetadata) ? "panel-closed" : "")" @ref="workArea">
        <MappingPanel @ref="mappingPanel" Analysis="analysis" Resolved="Resolved" Mappings="mappings" Changed="SetMapping" Compact="compact" Enabled="@(!EditingMetadata && (compact || !panelCollapsed))" Collapse="() => panelCollapsed = true" />
        <div class="panel-splitter" @ref="splitter" role="separator" tabindex="@((panelCollapsed || EditingMetadata || compact) ? -1 : 0)" aria-label="Resize operation mapping" aria-orientation="vertical" aria-valuemin="280" aria-valuemax="480" aria-valuenow="360"></div>
        <CanvasViewport ImageUrl="@(canvasView == "Batch" ? batchPreviewUrl : sourcePreviewUrl)" WidthPixels="@(canvasView == "Batch" ? sheet.Width * 96 : (analysis?.Width ?? 0) * 96)" HeightPixels="@(canvasView == "Batch" ? sheet.Height * 96 : (analysis?.Height ?? 0) * 96)" @bind-View="canvasView" HasBatch="@(rendering != null)" @bind-Background="woodColor" EmptyMessage="@(analysis == null ? "Open an SVG to begin." : "Preview unavailable for this source. Review Issues for details; valid metadata-only updates remain available.")" />
    </div>
    <footer class="workspace-footer">
        <div class="workspace-status"><p id="workspace-status" role="status" class="@(error != null || BlockingReason != null && analysis != null ? "status-blocked" : "")" title="@Status">@Status</p><small title="@FilenamePreview">Export: <span id="filenamePreview">@FilenamePreview</span></small></div>
        <SupportButton />
    </footer>
</div>
<WorkspaceDialog @ref="runtimeDialog" Title="Estimated Runtime">
    <ChildContent><p>Optional estimate for running the complete output SVG once, on any laser. Hours may exceed 23. Leave all fields blank if unknown.</p>
        <div class="runtime-fields"><div><label for="runtimeHours">Hours</label><input id="runtimeHours" class="form-control" inputmode="numeric" @bind="draftHours" /></div><div><label for="runtimeMinutes">Minutes</label><input id="runtimeMinutes" class="form-control" inputmode="numeric" @bind="draftMinutes" /></div><div><label for="runtimeSeconds">Seconds</label><input id="runtimeSeconds" class="form-control" inputmode="numeric" @bind="draftSeconds" /></div></div>
        <button class="btn btn-sm btn-outline-secondary mt-3" @onclick="() => { draftHours = draftMinutes = draftSeconds = null; draftError = null; }">Clear estimate</button>
        @if (draftError != null) { <p class="alert alert-danger mt-3" role="alert">@draftError</p> }
    </ChildContent><Actions><button class="btn btn-outline-secondary" @onclick="runtimeDialog.CloseAsync">Cancel</button><button class="btn btn-primary" @onclick="ApplyRuntime">Apply</button></Actions>
</WorkspaceDialog>
<WorkspaceDialog @ref="sheetDialog" Title="Sheet settings"><ChildContent>
    <SheetFields Value="draftSheet" Prefix="draft-" CanFill="@(analysis != null)" Fill="FillDraft" />
    <label for="draft-ordering" class="mt-3">Operation order</label><select id="draft-ordering" class="form-select" @bind="draftOrdering"><option value="@OrderingMode.WithinEachCopy">Within each copy</option><option value="@OrderingMode.AcrossSheet">Across the sheet</option></select>
    @if (analysis != null) { <p class="form-text">Source canvas: @analysis.Width.ToString("0.###") × @analysis.Height.ToString("0.###") in. Source canvas dimensions are preserved.</p> }
    @if (draftError != null) { <p class="alert alert-danger" role="alert">@draftError</p> }
</ChildContent><Actions><button class="btn btn-outline-secondary" @onclick="sheetDialog.CloseAsync">Cancel</button><button class="btn btn-primary" @onclick="ApplySheet">Apply</button></Actions></WorkspaceDialog>
<WorkspaceDialog @ref="programDialog" Title="Program metadata"><ChildContent>
    <ProgramFields Value="draftProgram" Prefix="draft-" EditingMetadata="EditingMetadata" />
    <p class="form-text">@(EditingMetadata ? "An edited total yield is stored as an override, retaining the original source yield and copy count." : "Total yield = parts per source SVG × copies. Program fields do not change artwork or clear the runtime estimate.")</p>
    @if (draftError != null) { <p class="alert alert-danger" role="alert">@draftError</p> }
</ChildContent><Actions><button class="btn btn-outline-secondary" @onclick="programDialog.CloseAsync">Cancel</button><button class="btn btn-primary" @onclick="ApplyProgram">Apply</button></Actions></WorkspaceDialog>
<WorkspaceDialog @ref="hiddenDialog" Title="Hidden and semantic content"><ChildContent>
    <p>Hidden artwork, semantic metadata, licensing and unrelated definitions are preserved separately from production ordering. Ignore applies only to production occurrences.</p>
    @if (analysis != null) {
        <ul class="hidden-inventory">@foreach (var item in analysis.Items.Where(i => i.Hidden || i.SemanticCategory != null || i.Element == "metadata")) { <li style="margin-left:@(Math.Min(item.Key.Count(c => c == '/'), 6) * 8)px"><details><summary>@item.Label · @item.Element</summary><p>Key: @item.Key · Parent: @(item.Parent ?? "none") · ID: @(item.Id ?? "none")<br />Visibility: @item.Visibility · Category: @(item.SemanticCategory ?? "none")</p><pre>@HiddenXml(item)</pre></details></li> }</ul>
        @if (!analysis.Items.Any(i => i.Hidden || i.SemanticCategory != null || i.Element == "metadata")) { <p>No hidden or semantic content was found.</p> }
    }
</ChildContent></WorkspaceDialog>
<WorkspaceDialog @ref="glowforgeDialog" Title="Glowforge settings"><ChildContent>
    <p>Read-only native settings. Raw values and readable reports are kept separate; no conversion is assumed. Selected operation and copy ordering determine the exported step sequence.</p>
    @if (analysis != null) { <div class="table-responsive"><table class="table table-sm" id="glowforgeSettings"><thead><tr><th>Native order / binding</th><th>Raw settings</th><th>Readable report</th></tr></thead><tbody>@foreach (var step in analysis.Glowforge.Steps.OrderBy(s => s.Order)) { <tr><td>@step.Order <small class="d-block text-break">@step.Class</small></td><td>@foreach (var value in step.RawAttributes.Where(p => p.Key != "class" && p.Key != "order")) { <div>@value.Key: @value.Value</div> }</td><td>@foreach (var line in step.ReportLines) { <div>@line</div> }</td></tr> }</tbody></table></div>
        @if (analysis.Glowforge.ReportLines.Count > 0) { <details><summary>Original settings report</summary>@foreach (var line in analysis.Glowforge.ReportLines) { <div>@line</div> }</details> }
    }
</ChildContent></WorkspaceDialog>
<WorkspaceDialog @ref="issuesDialog" Title="Issues"><ChildContent>
    @if (error != null) { <p class="alert alert-danger">@error</p> }
    @if (sourceNameError != null) { <p class="alert alert-danger">Source filename: @sourceNameError Correct the program fields to continue.</p> }
    @if (metadataConflict) { <div class="alert alert-warning"><p>The filename and embedded metadata disagree. Choose a source or correct the program fields.</p><p>Embedded: @ProgramNameParser.Format(analysis!.Metadata!.Program)<br />Filename: @ProgramNameParser.Format(filenameCandidate!)</p><div class="button-group"><button class="btn btn-outline-secondary" @onclick="() => UseProgram(analysis!.Metadata!.Program)">Use embedded metadata</button><button class="btn btn-outline-secondary" @onclick="() => UseProgram(filenameCandidate!)">Use filename metadata</button></div></div> }
    @foreach (var issue in analysis?.Errors ?? Array.Empty<string>()) { <p class="alert alert-danger">@issue</p> }
    @foreach (var warning in Warnings) { <p class="alert alert-warning">@warning</p> }
    @if (IssueCount == 0) { <p>No import or export issues.</p> }
    @if (BlockingReason != null) { <p>@BlockingReason</p> }
</ChildContent></WorkspaceDialog>
<WorkspaceDialog @ref="helpDialog" Title="Workspace help"><ChildContent>
    <h3>Assignments and Ignore</h3><p>The nearest explicit assignment wins. Assign a group, then override individual children as needed. “From source / parent” removes an explicit assignment. Ignore omits production geometry; hidden content and metadata remain preserved. Included clones keep the original artwork they reference in non-rendering definitions. Assignments do not propagate through clone references.</p>
    <h3>Inspect and render</h3><p>Click a thumbnail to inspect it inside the mapping panel. Enhanced previews use contrasting colors and approximately two-pixel strokes for inspection only. Original shows production styling. Neither view changes exported artwork. Render batch generates a preview; it never starts a laser. Clear preview returns to Source without resetting settings.</p>
    <h3>Canvas controls</h3><p>Drag or focus the canvas and use arrow keys to pan (Shift moves farther). Use + / − to zoom and Home to fit. Alt + scroll zooms; ordinary scroll pans. Browser zoom shortcuts remain available. Zoom ranges from 1% to 1600%; 100% means 96 CSS pixels per inch, not calibrated physical screen size. The panel divider also supports arrow keys, Home and End.</p>
    <h3>Preparing readable SVGs</h3><p>Use consistent, nonzero stroke widths and suitable contrast. Set fills and opacity intentionally, and give operation groups explicit labels such as Engrave, Score, InteriorCut and ExteriorCut. Thin, dashed, pale or transparent marks can be hard to inspect at small sizes. Use Enhanced previews instead of changing production styling just to improve thumbnails. Raster images retain their original appearance.</p>
    <h3>Metadata and runtime</h3><p>Estimated Runtime is a user-entered estimate for the entire output job, regardless of laser type, copies or yield. Changes to sheet settings, copies, assignments or ordering clear it. Program fields and view controls retain it. Re-upload a supported LaserBatcher export to edit metadata without re-batching, fitting or changing its artwork.</p>
    <h3>Operation order</h3><p>Engrave → Score → InteriorCut → ExteriorCut. Per-copy ordering completes copies sooner; across-sheet ordering keeps stock intact through engraving and scoring. Laser software controls actual execution order. Review native ordering warnings and verify settings in your laser software.</p>
</ChildContent></WorkspaceDialog>
