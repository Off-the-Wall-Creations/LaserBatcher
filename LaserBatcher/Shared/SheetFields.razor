@using LaserBatcher.Models
<div class="sheet-fields compact-fields">
    <div class="field-pair"><span>Sheet (in)</span><div><label for="@(Prefix + "boxWidth")" class="visually-hidden">Width (in)</label><input id="@(Prefix + "boxWidth")" aria-label="Width (in)" type="number" class="form-control form-control-sm" min="0.1" step="0.1" @bind="Value.Width" @bind:after="NotifyChanged" /><span>×</span><label for="@(Prefix + "boxHeight")" class="visually-hidden">Height (in)</label><input id="@(Prefix + "boxHeight")" aria-label="Height (in)" type="number" class="form-control form-control-sm" min="0.1" step="0.1" @bind="Value.Height" @bind:after="NotifyChanged" /></div></div>
    <div class="field-pair"><span>Margins H / V (in)</span><div><label for="@(Prefix + "horizontalMargin")" class="visually-hidden">Horizontal margin (in)</label><input id="@(Prefix + "horizontalMargin")" aria-label="Horizontal margin (in)" type="number" class="form-control form-control-sm" min="0" step="0.1" @bind="Value.HorizontalMargin" @bind:after="NotifyChanged" /><span>/</span><label for="@(Prefix + "verticalMargin")" class="visually-hidden">Vertical margin (in)</label><input id="@(Prefix + "verticalMargin")" aria-label="Vertical margin (in)" type="number" class="form-control form-control-sm" min="0" step="0.1" @bind="Value.VerticalMargin" @bind:after="NotifyChanged" /></div></div>
    <div><label for="@(Prefix + "spaceBetween")">Spacing (in)</label><input id="@(Prefix + "spaceBetween")" class="form-control form-control-sm" type="number" min="0" step="0.1" @bind="Value.Spacing" @bind:after="NotifyChanged" /></div>
    <div><label for="@(Prefix + "copyQuantity")">Copies</label><div class="input-group input-group-sm"><input id="@(Prefix + "copyQuantity")" class="form-control" type="number" min="1" @bind="Value.Copies" @bind:after="NotifyChanged" /><button class="btn btn-outline-secondary" disabled="@(!CanFill)" @onclick="Fill">Fill</button></div></div>
</div>
@code {
    [Parameter, EditorRequired] public SheetForm Value { get; set; } = default!;
    [Parameter] public string Prefix { get; set; } = "";
    [Parameter] public bool CanFill { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private Task NotifyChanged() => Changed.InvokeAsync();
    [Parameter] public EventCallback Fill { get; set; }
}

