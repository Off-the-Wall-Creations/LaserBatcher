<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" PrivateAssets="all" />
    <!-- Compile the browser-independent production services without the WASM host. -->
    <Compile Include="../LaserBatcher/Services/*.cs" Link="Services/%(Filename)%(Extension)" />
    <None Update="Fixtures/*.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
